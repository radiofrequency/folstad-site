---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BuzzChrome from "../../components/buzz/BuzzChrome.astro";
import "../../styles/buzz-app.css";
---

<BaseLayout
  title="Dashboard · Buzz | Folstad AI"
  description="List and manage your Buzz projects."
>
  <div class="bz-app">
    <BuzzChrome active="dashboard" />
    <main class="bz-app__main bz-app__main--wide" id="main">
      <span class="section-label">Dashboard</span>
      <h1 class="bz-title">Your projects</h1>
      <p class="bz-lede">Projects you launched while signed in. Stop, restart, and inspect logs from each detail page.</p>
      <p class="bz-mode" data-mode></p>
      <div class="bz-actions" style="margin-top:0;margin-bottom:1.5rem">
        <a class="btn" href={`${import.meta.env.BASE_URL}buzz`}>
          Launch new
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
        <button type="button" class="btn btn--ghost" data-refresh>Refresh</button>
      </div>
      <p class="bz-error" data-error hidden></p>
      <div data-list>
        <p class="bz-empty">Loading…</p>
      </div>
    </main>
  </div>
  <script>
    import { requireSession } from "../../lib/buzz-auth";
    import { isMockApi, listProjects } from "../../lib/buzz-api";
    import type { Project } from "../../lib/buzz-types";

    const session = requireSession(`${import.meta.env.BASE_URL}dashboard`);
    if (!session) {
      /* redirecting */
    } else {
      const mode = document.querySelector("[data-mode]");
      if (mode) {
        mode.textContent = isMockApi()
          ? "Local mock API + Cognito mock (no AWS deploy required)"
          : "Live Buzz API";
      }

      async function render() {
        const list = document.querySelector("[data-list]");
        const err = document.querySelector<HTMLElement>("[data-error]");
        if (!list) return;
        try {
          if (err) err.hidden = true;
          const projects = await listProjects();
          if (projects.length === 0) {
            list.innerHTML = `<p class="bz-empty">No projects yet. <a href="${import.meta.env.BASE_URL}buzz">Launch your first Buzz</a>.</p>`;
            return;
          }
          list.innerHTML = `
            <table class="bz-table">
              <thead>
                <tr>
                  <th>Project</th>
                  <th>Domain</th>
                  <th>Status</th>
                  <th>Health</th>
                </tr>
              </thead>
              <tbody>
                ${projects.map(row).join("")}
              </tbody>
            </table>`;
        } catch (ex) {
          if (err) {
            err.hidden = false;
            err.textContent = ex instanceof Error ? ex.message : "Failed to load";
          }
          list.innerHTML = "";
        }
      }

      function row(p: Project): string {
        const href = `${import.meta.env.BASE_URL}dashboard/project?id=${encodeURIComponent(p.projectId)}`;
        return `<tr>
          <td><a href="${href}"><strong>${esc(p.projectName)}</strong></a><br/><span style="color:var(--slate)">${esc(p.industryLabel)}</span></td>
          <td class="mono">${esc(p.domain)}</td>
          <td><span class="bz-badge bz-badge--${p.status}">${p.status}</span></td>
          <td><span class="bz-badge bz-badge--${p.health}">${p.health}</span></td>
        </tr>`;
      }

      function esc(s: string) {
        return s.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;");
      }

      document.querySelector("[data-refresh]")?.addEventListener("click", () => void render());
      void render();
    }
  </script>
</BaseLayout>
