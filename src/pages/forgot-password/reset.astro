---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BuzzChrome from "../../components/buzz/BuzzChrome.astro";
import "../../styles/buzz-app.css";
---

<BaseLayout
  title="Choose a new password · Buzz | Folstad AI"
  description="Enter your email code and choose a new Buzz password."
>
  <div class="bz-app">
    <BuzzChrome active="auth" />
    <main class="bz-app__main" id="main">
      <span class="section-label">Account</span>
      <h1 class="bz-title">Choose a new password</h1>
      <p class="bz-lede">
        Use the code from your email. Fill your email and new password so your password manager
        can save them together.
      </p>

      {/*
        Standalone page: all credential fields are in the first paint (not un-hidden later).
        Google Password Manager only reliably fills/saves when username + new-password exist
        on load inside one form.
      */}
      <form
        class="bz-form"
        id="password-reset-form"
        method="post"
        action="#"
        data-reset-form
      >
        <label class="bz-field">
          <span class="bz-label">Email</span>
          <input
            class="bz-input"
            type="email"
            name="username"
            id="username"
            required
            autocomplete="username"
            autocapitalize="off"
            autocorrect="off"
            spellcheck="false"
            inputmode="email"
            data-email
          />
        </label>

        <label class="bz-field">
          <span class="bz-label">Reset code</span>
          <input
            class="bz-input"
            type="text"
            name="one-time-code"
            id="one-time-code"
            required
            inputmode="numeric"
            autocomplete="one-time-code"
            placeholder="Code from email"
            data-code
          />
        </label>

        <label class="bz-field">
          <span class="bz-label">New password</span>
          <input
            class="bz-input"
            type="password"
            name="new-password"
            id="new-password"
            required
            minlength="8"
            autocomplete="new-password"
            data-password
          />
        </label>

        <label class="bz-field">
          <span class="bz-label">Confirm new password</span>
          {/*
            Not autocomplete=new-password — managers only fill one field; we mirror
            the primary password into confirm via JS when Google suggests one.
          */}
          <input
            class="bz-input"
            type="password"
            name="confirm-password"
            id="confirm-password"
            required
            minlength="8"
            autocomplete="off"
            data-password2
          />
        </label>

        <p class="bz-hint">Min 8 characters, with upper, lower, and a number. Confirm fills automatically if you use a password manager.</p>

        <style is:global>
          /* Chrome fires animationstart on autofill — used to sync confirm field */
          @keyframes buzz-on-autofill {
            from {
              opacity: 0.99;
            }
            to {
              opacity: 1;
            }
          }
          #new-password:-webkit-autofill {
            animation-name: buzz-on-autofill;
            animation-duration: 0.001s;
          }
        </style>
        <p class="bz-error" data-error hidden></p>
        <p class="bz-hint" data-ok hidden style="color: var(--signal)"></p>

        <div class="bz-actions" data-actions-form>
          <button class="btn" type="submit" data-submit>
            Set new password
            <span class="btn__arrow" aria-hidden="true">→</span>
          </button>
          <button class="btn btn--ghost" type="button" data-resend>Resend code</button>
          <a class="btn btn--ghost" href={`${import.meta.env.BASE_URL}forgot-password`}>Start over</a>
        </div>

        {/* Stay on page after success so password managers can save; user continues explicitly */}
        <div class="bz-actions" data-actions-done hidden>
          <a class="btn" data-continue-login href={`${import.meta.env.BASE_URL}login`}>
            Continue to sign in
            <span class="btn__arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </form>
    </main>
  </div>

  {/* Inline: set email before module scripts so PM sees username on first scan */}
  <script is:inline>
    (function () {
      try {
        var email = new URLSearchParams(location.search).get("email");
        if (!email) return;
        var el = document.getElementById("username");
        if (el) {
          el.value = email;
          el.setAttribute("value", email);
        }
      } catch (e) {}
    })();
  </script>

  <script>
    import {
      appPath,
      confirmForgotPassword,
      forgotPassword,
    } from "../../lib/buzz-auth";

    const form = document.querySelector<HTMLFormElement>("[data-reset-form]");
    const emailInput = document.querySelector<HTMLInputElement>("[data-email]");
    const codeInput = document.querySelector<HTMLInputElement>("[data-code]");
    const passwordInput = document.querySelector<HTMLInputElement>("[data-password]");
    const password2Input = document.querySelector<HTMLInputElement>("[data-password2]");
    const errEl = document.querySelector<HTMLElement>("[data-error]");
    const okEl = document.querySelector<HTMLElement>("[data-ok]");
    const btn = document.querySelector<HTMLButtonElement>("[data-submit]");

    // Re-apply email after modules load (and if query was missing on first paint)
    const params = new URLSearchParams(window.location.search);
    const emailParam = params.get("email")?.trim().toLowerCase() ?? "";
    if (emailInput && emailParam) {
      emailInput.value = emailParam;
      emailInput.setAttribute("value", emailParam);
    } else if (!emailParam) {
      // No email in URL — send them back to start
      window.location.replace(appPath("/forgot-password"));
    }

    /** Google PM only fills the first new-password field — mirror into confirm. */
    function syncConfirmFromPrimary() {
      if (!passwordInput || !password2Input) return;
      if (passwordInput.value && password2Input.value !== passwordInput.value) {
        password2Input.value = passwordInput.value;
        // Notify any listeners / PM that confirm is populated
        password2Input.dispatchEvent(new Event("input", { bubbles: true }));
      }
    }

    passwordInput?.addEventListener("input", syncConfirmFromPrimary);
    passwordInput?.addEventListener("change", syncConfirmFromPrimary);
    passwordInput?.addEventListener("keyup", syncConfirmFromPrimary);
    passwordInput?.addEventListener("animationstart", (e) => {
      if ((e as AnimationEvent).animationName === "buzz-on-autofill") {
        syncConfirmFromPrimary();
      }
    });
    // GPM often fills without reliable events — poll briefly while focused
    let poll: number | undefined;
    passwordInput?.addEventListener("focus", () => {
      let n = 0;
      window.clearInterval(poll);
      poll = window.setInterval(() => {
        syncConfirmFromPrimary();
        if (++n > 40) window.clearInterval(poll);
      }, 100);
    });
    passwordInput?.addEventListener("blur", () => {
      window.clearInterval(poll);
      syncConfirmFromPrimary();
    });

    function showErr(msg: string | null) {
      if (!errEl) return;
      if (msg) {
        errEl.hidden = false;
        errEl.textContent = msg;
      } else {
        errEl.hidden = true;
        errEl.textContent = "";
      }
    }

    function showOk(msg: string | null) {
      if (!okEl) return;
      if (msg) {
        okEl.hidden = false;
        okEl.textContent = msg;
      } else {
        okEl.hidden = true;
        okEl.textContent = "";
      }
    }

    /**
     * JS preventDefault + fetch often skips the browser save prompt.
     * Credential Management API explicitly asks Chrome/Edge to save/update.
     */
    async function offerPasswordSave(email: string, password: string): Promise<void> {
      try {
        const PasswordCredentialCtor = (
          window as unknown as {
            PasswordCredential?: new (data: {
              id: string;
              password: string;
              name?: string;
            }) => Credential;
          }
        ).PasswordCredential;

        if (!PasswordCredentialCtor || !navigator.credentials?.store) return;

        const cred = new PasswordCredentialCtor({
          id: email,
          password,
          name: email,
        });
        await navigator.credentials.store(cred);
      } catch {
        // User dismissed the dialog, or browser blocked it (needs HTTPS).
      }
    }

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      showErr(null);
      showOk(null);

      const email = emailInput?.value?.trim().toLowerCase() ?? "";
      const code = codeInput?.value ?? "";
      syncConfirmFromPrimary();
      const password = passwordInput?.value ?? "";
      const password2 = password2Input?.value || password;

      if (!email) {
        showErr("Email is required.");
        emailInput?.focus();
        return;
      }
      if (!password) {
        showErr("Enter a new password.");
        return;
      }
      if (password !== password2) {
        showErr("Passwords do not match.");
        return;
      }

      if (emailInput) {
        emailInput.value = email;
        emailInput.setAttribute("value", email);
      }

      try {
        if (btn) btn.disabled = true;
        await confirmForgotPassword(email, code, password);

        // Prompt password manager while form still shows email + new password
        await offerPasswordSave(email, password);

        showOk("Password updated. Save it in your password manager if prompted, then continue.");

        // Don’t auto-redirect — leaving the filled form on screen helps managers,
        // and the user can finish the save UI first.
        const actionsForm = document.querySelector<HTMLElement>("[data-actions-form]");
        const actionsDone = document.querySelector<HTMLElement>("[data-actions-done]");
        if (actionsForm) actionsForm.hidden = true;
        if (actionsDone) actionsDone.hidden = false;

        const cont = document.querySelector<HTMLAnchorElement>("[data-continue-login]");
        if (cont) {
          const q = new URLSearchParams({ email });
          cont.href = `${appPath("/login")}?${q}`;
          cont.focus();
        }

        // Soften fields so they stay readable for the save prompt but aren’t re-edited
        if (passwordInput) passwordInput.readOnly = true;
        if (password2Input) password2Input.readOnly = true;
        if (emailInput) emailInput.readOnly = true;
        if (codeInput) codeInput.readOnly = true;
      } catch (ex) {
        showErr(ex instanceof Error ? ex.message : "Reset failed");
        if (btn) btn.disabled = false;
      }
    });

    document.querySelector("[data-resend]")?.addEventListener("click", async () => {
      const email = emailInput?.value?.trim().toLowerCase() ?? "";
      showErr(null);
      try {
        const res = await forgotPassword(email);
        showOk(res.message);
      } catch (ex) {
        showErr(ex instanceof Error ? ex.message : "Could not resend");
      }
    });
  </script>
</BaseLayout>
