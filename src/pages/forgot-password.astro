---
import BaseLayout from "../layouts/BaseLayout.astro";
import BuzzChrome from "../components/buzz/BuzzChrome.astro";
import "../styles/buzz-app.css";
---

<BaseLayout
  title="Reset password · Buzz | Folstad AI"
  description="Reset your Buzz account password with an email code."
>
  <div class="bz-app">
    <BuzzChrome active="auth" />
    <main class="bz-app__main" id="main">
      <span class="section-label">Account</span>
      <h1 class="bz-title">Reset password</h1>
      <p class="bz-lede" data-lede>
        Enter your email and we’ll send a reset code. Then choose a new password.
      </p>
      <p class="bz-mode" data-auth-mode></p>

      <!-- Step 1: request code -->
      <form data-step="request" data-request-form>
        <label class="bz-field">
          <span class="bz-label">Email</span>
          <input
            class="bz-input"
            type="email"
            name="email"
            required
            autocomplete="username"
            data-email
          />
        </label>
        <p class="bz-error" data-error-request hidden></p>
        <p class="bz-hint" data-ok-request hidden style="color: var(--signal)"></p>
        <div class="bz-actions">
          <button class="btn" type="submit" data-submit-request>
            Send reset code
            <span class="btn__arrow" aria-hidden="true">→</span>
          </button>
          <a class="btn btn--ghost" href={`${import.meta.env.BASE_URL}login`}>Back to sign in</a>
        </div>
      </form>

      <!-- Step 2: confirm new password -->
      <form data-step="reset" data-reset-form hidden>
        <label class="bz-field">
          <span class="bz-label">Email</span>
          <input
            class="bz-input"
            type="email"
            name="email"
            required
            autocomplete="username"
            data-reset-email
          />
        </label>
        <label class="bz-field">
          <span class="bz-label">Reset code</span>
          <input
            class="bz-input"
            type="text"
            name="code"
            required
            inputmode="numeric"
            autocomplete="one-time-code"
            placeholder="Code from email"
            data-code
          />
        </label>
        <label class="bz-field">
          <span class="bz-label">New password</span>
          <input
            class="bz-input"
            type="password"
            name="password"
            required
            minlength="8"
            autocomplete="new-password"
          />
        </label>
        <label class="bz-field">
          <span class="bz-label">Confirm new password</span>
          <input
            class="bz-input"
            type="password"
            name="password2"
            required
            minlength="8"
            autocomplete="new-password"
          />
        </label>
        <p class="bz-hint">Min 8 characters, with upper, lower, and a number.</p>
        <p class="bz-error" data-error-reset hidden></p>
        <p class="bz-hint" data-ok-reset hidden style="color: var(--signal)"></p>
        <div class="bz-actions">
          <button class="btn" type="submit" data-submit-reset>
            Set new password
            <span class="btn__arrow" aria-hidden="true">→</span>
          </button>
          <button class="btn btn--ghost" type="button" data-resend>Resend code</button>
          <a class="btn btn--ghost" href={`${import.meta.env.BASE_URL}login`}>Sign in</a>
        </div>
      </form>
    </main>
  </div>
  <script>
    import {
      appPath,
      authModeLabel,
      confirmForgotPassword,
      forgotPassword,
    } from "../lib/buzz-auth";

    const mode = document.querySelector("[data-auth-mode]");
    if (mode) mode.textContent = authModeLabel();

    const params = new URLSearchParams(window.location.search);
    const requestForm = document.querySelector<HTMLFormElement>("[data-request-form]");
    const resetForm = document.querySelector<HTMLFormElement>("[data-reset-form]");
    const lede = document.querySelector("[data-lede]");
    const emailInput = document.querySelector<HTMLInputElement>("[data-email]");
    const resetEmailInput = document.querySelector<HTMLInputElement>("[data-reset-email]");

    if (emailInput && params.get("email")) emailInput.value = params.get("email")!;
    if (params.get("step") === "reset") showReset(params.get("email") || "");

    function showReset(email: string) {
      if (requestForm) requestForm.hidden = true;
      if (resetForm) resetForm.hidden = false;
      if (lede) {
        lede.textContent =
          "Enter the code from your email and choose a new password.";
      }
      if (resetEmailInput && email) resetEmailInput.value = email;
    }

    function showErr(el: HTMLElement | null, msg: string | null) {
      if (!el) return;
      if (msg) {
        el.hidden = false;
        el.textContent = msg;
      } else {
        el.hidden = true;
        el.textContent = "";
      }
    }

    function showOk(el: HTMLElement | null, msg: string) {
      if (!el) return;
      el.hidden = false;
      el.textContent = msg;
    }

    requestForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const fd = new FormData(requestForm);
      const email = String(fd.get("email"));
      const err = document.querySelector<HTMLElement>("[data-error-request]");
      const ok = document.querySelector<HTMLElement>("[data-ok-request]");
      const btn = document.querySelector<HTMLButtonElement>("[data-submit-request]");
      try {
        showErr(err, null);
        if (ok) ok.hidden = true;
        if (btn) btn.disabled = true;
        const res = await forgotPassword(email);
        showOk(ok, res.message);
        showReset(email);
        history.replaceState(
          null,
          "",
          `${appPath("/forgot-password")}?step=reset&email=${encodeURIComponent(email)}`,
        );
      } catch (ex) {
        showErr(err, ex instanceof Error ? ex.message : "Could not send code");
      } finally {
        if (btn) btn.disabled = false;
      }
    });

    resetForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const fd = new FormData(resetForm);
      const email = String(fd.get("email"));
      const code = String(fd.get("code"));
      const password = String(fd.get("password"));
      const password2 = String(fd.get("password2"));
      const err = document.querySelector<HTMLElement>("[data-error-reset]");
      const ok = document.querySelector<HTMLElement>("[data-ok-reset]");
      const btn = document.querySelector<HTMLButtonElement>("[data-submit-reset]");

      if (password !== password2) {
        showErr(err, "Passwords do not match.");
        return;
      }

      try {
        showErr(err, null);
        if (ok) ok.hidden = true;
        if (btn) btn.disabled = true;
        await confirmForgotPassword(email, code, password);
        showOk(ok, "Password updated. Redirecting to sign in…");
        const q = new URLSearchParams({ email });
        window.location.replace(`${appPath("/login")}?${q}`);
      } catch (ex) {
        showErr(err, ex instanceof Error ? ex.message : "Reset failed");
      } finally {
        if (btn) btn.disabled = false;
      }
    });

    document.querySelector("[data-resend]")?.addEventListener("click", async () => {
      const email = resetEmailInput?.value?.trim() || emailInput?.value?.trim() || "";
      const err = document.querySelector<HTMLElement>("[data-error-reset]");
      const ok = document.querySelector<HTMLElement>("[data-ok-reset]");
      try {
        showErr(err, null);
        const res = await forgotPassword(email);
        showOk(ok, res.message);
      } catch (ex) {
        showErr(err, ex instanceof Error ? ex.message : "Could not resend");
      }
    });
  </script>
</BaseLayout>
