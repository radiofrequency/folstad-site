---
import BaseLayout from "../layouts/BaseLayout.astro";
import BuzzChrome from "../components/buzz/BuzzChrome.astro";
import "../styles/buzz-app.css";
---

<BaseLayout
  title="Reset password · Buzz | Folstad AI"
  description="Reset your Buzz account password with an email code."
>
  <div class="bz-app">
    <BuzzChrome active="auth" />
    <main class="bz-app__main" id="main">
      <span class="section-label">Account</span>
      <h1 class="bz-title">Reset password</h1>
      <p class="bz-lede">
        Enter your account email. We’ll send a one-time code, then you can set a new password.
      </p>

      <form class="bz-form" data-request-form method="post" action="#">
        <label class="bz-field">
          <span class="bz-label">Email</span>
          <input
            class="bz-input"
            type="email"
            name="username"
            id="username"
            required
            autocomplete="username"
            autocapitalize="off"
            autocorrect="off"
            spellcheck="false"
            inputmode="email"
            data-email
          />
        </label>
        <p class="bz-error" data-error hidden></p>
        <p class="bz-hint" data-ok hidden style="color: var(--signal)"></p>
        <div class="bz-actions">
          <button class="btn" type="submit" data-submit>
            Send reset code
            <span class="btn__arrow" aria-hidden="true">→</span>
          </button>
          <a class="btn btn--ghost" href={`${import.meta.env.BASE_URL}login`}>Back to sign in</a>
        </div>
      </form>
    </main>
  </div>
  <script>
    import { appPath, forgotPassword } from "../lib/buzz-auth";

    const form = document.querySelector<HTMLFormElement>("[data-request-form]");
    const emailInput = document.querySelector<HTMLInputElement>("[data-email]");
    const errEl = document.querySelector<HTMLElement>("[data-error]");
    const okEl = document.querySelector<HTMLElement>("[data-ok]");
    const btn = document.querySelector<HTMLButtonElement>("[data-submit]");

    const params = new URLSearchParams(window.location.search);
    if (emailInput && params.get("email")) emailInput.value = params.get("email")!;

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const email = emailInput?.value?.trim().toLowerCase() ?? "";
      if (!email) return;

      try {
        if (errEl) errEl.hidden = true;
        if (okEl) okEl.hidden = true;
        if (btn) btn.disabled = true;
        const res = await forgotPassword(email);
        if (okEl) {
          okEl.hidden = false;
          okEl.textContent = res.message;
        }
        // Full navigation so the next page paints all password fields for Google PM
        const q = new URLSearchParams({ email });
        window.location.assign(`${appPath("/forgot-password/reset")}?${q}`);
      } catch (ex) {
        if (errEl) {
          errEl.hidden = false;
          errEl.textContent = ex instanceof Error ? ex.message : "Could not send code";
        }
        if (btn) btn.disabled = false;
      }
    });
  </script>
</BaseLayout>
