---
import BaseLayout from "../layouts/BaseLayout.astro";
import BuzzChrome from "../components/buzz/BuzzChrome.astro";
import "../styles/buzz-app.css";
---

<BaseLayout
  title="Reset password · Buzz | Folstad AI"
  description="Reset your Buzz account password with an email code."
>
  <div class="bz-app">
    <BuzzChrome active="auth" />
    <main class="bz-app__main" id="main">
      <span class="section-label">Account</span>
      <h1 class="bz-title">Reset password</h1>
      <p class="bz-lede" data-lede>
        Enter your email and we’ll send a reset code. Then choose a new password.
      </p>

      {/*
        Single form so password managers pair email + new password.
        Two separate forms left a hidden empty username that browsers saved blank.
      */}
      <form
        class="bz-form"
        data-reset-flow
        method="post"
        action="#"
        autocomplete="on"
      >
        <label class="bz-field">
          <span class="bz-label">Email</span>
          <input
            class="bz-input"
            type="email"
            name="username"
            id="reset-username"
            required
            autocomplete="username"
            inputmode="email"
            data-email
          />
        </label>

        <div data-step-reset hidden>
          <label class="bz-field">
            <span class="bz-label">Reset code</span>
            <input
              class="bz-input"
              type="text"
              name="code"
              inputmode="numeric"
              autocomplete="one-time-code"
              placeholder="Code from email"
              data-code
            />
          </label>
          <label class="bz-field">
            <span class="bz-label">New password</span>
            <input
              class="bz-input"
              type="password"
              name="new-password"
              id="reset-new-password"
              minlength="8"
              autocomplete="new-password"
              data-password
            />
          </label>
          <label class="bz-field">
            <span class="bz-label">Confirm new password</span>
            <input
              class="bz-input"
              type="password"
              name="new-password-confirm"
              minlength="8"
              autocomplete="new-password"
              data-password2
            />
          </label>
          <p class="bz-hint">Min 8 characters, with upper, lower, and a number.</p>
        </div>

        <p class="bz-error" data-error hidden></p>
        <p class="bz-hint" data-ok hidden style="color: var(--signal)"></p>

        <div class="bz-actions" data-actions-request>
          <button class="btn" type="submit" data-action="request">
            Send reset code
            <span class="btn__arrow" aria-hidden="true">→</span>
          </button>
          <a class="btn btn--ghost" href={`${import.meta.env.BASE_URL}login`}>Back to sign in</a>
        </div>

        <div class="bz-actions" data-actions-reset hidden>
          <button class="btn" type="submit" data-action="reset">
            Set new password
            <span class="btn__arrow" aria-hidden="true">→</span>
          </button>
          <button class="btn btn--ghost" type="button" data-resend>Resend code</button>
          <a class="btn btn--ghost" href={`${import.meta.env.BASE_URL}login`}>Sign in</a>
        </div>
      </form>
    </main>
  </div>
  <script>
    import {
      appPath,
      confirmForgotPassword,
      forgotPassword,
    } from "../lib/buzz-auth";

    const form = document.querySelector<HTMLFormElement>("[data-reset-flow]");
    const lede = document.querySelector("[data-lede]");
    const emailInput = document.querySelector<HTMLInputElement>("[data-email]");
    const codeInput = document.querySelector<HTMLInputElement>("[data-code]");
    const passwordInput = document.querySelector<HTMLInputElement>("[data-password]");
    const password2Input = document.querySelector<HTMLInputElement>("[data-password2]");
    const stepReset = document.querySelector<HTMLElement>("[data-step-reset]");
    const actionsRequest = document.querySelector<HTMLElement>("[data-actions-request]");
    const actionsReset = document.querySelector<HTMLElement>("[data-actions-reset]");
    const errEl = document.querySelector<HTMLElement>("[data-error]");
    const okEl = document.querySelector<HTMLElement>("[data-ok]");

    let phase: "request" | "reset" = "request";

    const params = new URLSearchParams(window.location.search);
    if (emailInput && params.get("email")) {
      emailInput.value = params.get("email")!;
    }
    if (params.get("step") === "reset" && params.get("email")) {
      enterResetPhase(params.get("email")!);
    }

    function showErr(msg: string | null) {
      if (!errEl) return;
      if (msg) {
        errEl.hidden = false;
        errEl.textContent = msg;
      } else {
        errEl.hidden = true;
        errEl.textContent = "";
      }
    }

    function showOk(msg: string | null) {
      if (!okEl) return;
      if (msg) {
        okEl.hidden = false;
        okEl.textContent = msg;
      } else {
        okEl.hidden = true;
        okEl.textContent = "";
      }
    }

    function enterResetPhase(email: string) {
      phase = "reset";
      if (emailInput) {
        emailInput.value = email;
        // Keep username in the form for password managers; lock editing after code sent
        emailInput.readOnly = true;
      }
      if (stepReset) stepReset.hidden = false;
      if (actionsRequest) actionsRequest.hidden = true;
      if (actionsReset) actionsReset.hidden = false;
      if (lede) {
        lede.textContent =
          "Enter the code from your email and choose a new password.";
      }
      // Only require code/password on step 2
      codeInput?.setAttribute("required", "");
      passwordInput?.setAttribute("required", "");
      password2Input?.setAttribute("required", "");
      history.replaceState(
        null,
        "",
        `${appPath("/forgot-password")}?step=reset&email=${encodeURIComponent(email)}`,
      );
      codeInput?.focus();
    }

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      showErr(null);
      showOk(null);

      const email = emailInput?.value?.trim().toLowerCase() ?? "";
      if (!email) {
        showErr("Email is required.");
        return;
      }

      if (phase === "request") {
        const btn = document.querySelector<HTMLButtonElement>('[data-action="request"]');
        try {
          if (btn) btn.disabled = true;
          const res = await forgotPassword(email);
          showOk(res.message);
          enterResetPhase(email);
        } catch (ex) {
          showErr(ex instanceof Error ? ex.message : "Could not send code");
        } finally {
          if (btn) btn.disabled = false;
        }
        return;
      }

      // phase === reset
      const code = codeInput?.value ?? "";
      const password = passwordInput?.value ?? "";
      const password2 = password2Input?.value ?? "";
      const btn = document.querySelector<HTMLButtonElement>('[data-action="reset"]');

      if (password !== password2) {
        showErr("Passwords do not match.");
        return;
      }

      try {
        if (btn) btn.disabled = true;
        await confirmForgotPassword(email, code, password);
        showOk("Password updated. Redirecting to sign in…");
        // Navigate after a tick so managers can bind username+password from this form
        const q = new URLSearchParams({ email });
        window.setTimeout(() => {
          window.location.assign(`${appPath("/login")}?${q}`);
        }, 150);
      } catch (ex) {
        showErr(ex instanceof Error ? ex.message : "Reset failed");
        if (btn) btn.disabled = false;
      }
    });

    document.querySelector("[data-resend]")?.addEventListener("click", async () => {
      const email = emailInput?.value?.trim() ?? "";
      showErr(null);
      try {
        const res = await forgotPassword(email);
        showOk(res.message);
      } catch (ex) {
        showErr(ex instanceof Error ? ex.message : "Could not resend");
      }
    });
  </script>
</BaseLayout>
