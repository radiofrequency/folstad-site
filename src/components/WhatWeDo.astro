---
const outcomes = [
  "Fewer manual tickets and handoffs",
  "Faster response without more headcount",
  "Cleaner books and fewer entry errors",
  "Consistent social and support presence",
];
---

<section class="section section--veil" id="what-we-do" aria-labelledby="what-title">
  <div class="wrap reveal">
    <span class="section-label">What we do</span>
    <h2 id="what-title" class="section-title">Software that runs the work people shouldn’t.</h2>
    <p class="section-lede">
      New tools make it possible for companies large and small to cut operational drag, ease headcount
      pressure where automation fits, and remove human error from repeatable work. We set up software
      that automates the business — end to end where it makes sense.
    </p>
    <ul class="outcomes">
      {
        outcomes.map((item) => (
          <li class="outcomes__item">
            <span class="outcomes__dot" aria-hidden="true" />
            {item}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .outcomes {
    list-style: none;
    margin: var(--space-8) 0 0;
    padding: 0;
    display: grid;
    gap: 0;
    max-width: 32rem;
  }

  .outcomes__item {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--ghost);
    font-size: var(--text-base);
    color: var(--ink);
  }

  .outcomes__item:last-child {
    border-bottom: 1px solid var(--ghost);
  }

  .outcomes__dot {
    flex-shrink: 0;
    width: 0.35rem;
    height: 0.35rem;
    margin-top: 0.55em;
    border-radius: 50%;
    background: var(--signal);
    opacity: 0.7;
  }
</style>
