---
import { X_DM_URL } from "../lib/links";

const tiers = [
  {
    id: "pilot",
    name: "Pilot",
    price: "$4,900",
    cadence: "one-time",
    blurb: "One starter-kit vertical, live in weeks — not a slide deck.",
    features: [
      "Choose one SME kit (or a tightly scoped first workflow)",
      "Agents shaped to your data and processes",
      "Deploy 1–2 production workflows",
      "30 days of post-launch tuning",
    ],
    note: "Best first engagement for most small teams.",
  },
  {
    id: "build",
    name: "Build",
    price: "from $12,000",
    cadence: "project",
    blurb: "Multi-domain custom agents with deeper integrations.",
    features: [
      "Scoped statement of work before kickoff",
      "Email, CRM, support, books, or your stack",
      "Multi-workflow agent systems",
      "Handoff docs and operator training",
    ],
    note: "Complex legal, accounting, or security scopes quote higher.",
  },
  {
    id: "run",
    name: "Run",
    price: "$1,800",
    cadence: "/ month",
    blurb: "Keep agents reliable as models, tools, and your business change.",
    features: [
      "Monitoring and reliability checks",
      "Prompt and model updates",
      "Light new workflows each month",
      "Priority support via X",
    ],
    note: "Month-to-month after setup. Recommended once live.",
  },
];
---

<section class="section" id="pricing" aria-labelledby="pricing-title">
  <div class="wrap reveal">
    <span class="section-label">Pricing</span>
    <h2 id="pricing-title" class="section-title">Clear fees. Hybrid by design.</h2>
    <p class="section-lede">
      Launch with a fixed project. Stay online with a light retainer. Discovery starts on X — you get a
      scoped quote before any work begins.
    </p>

    <div class="tiers">
      {
        tiers.map((tier) => (
          <article class="tier" id={`pricing-${tier.id}`}>
            <header class="tier__head">
              <h3 class="tier__name">{tier.name}</h3>
              <p class="tier__price">
                <span class="tier__amount">{tier.price}</span>
                <span class="tier__cadence">{tier.cadence}</span>
              </p>
              <p class="tier__blurb">{tier.blurb}</p>
            </header>
            <ul class="tier__list">
              {tier.features.map((f) => (
                <li>{f}</li>
              ))}
            </ul>
            <p class="tier__note">{tier.note}</p>
          </article>
        ))
      }
    </div>

    <article class="founding" id="pricing-founding" aria-labelledby="founding-title">
      <div class="founding__intro">
        <h3 id="founding-title" class="founding__name">New Business</h3>
        <p class="founding__price">
          <span class="tier__amount">Custom quote</span>
        </p>
        <p class="founding__blurb">
          Start your business right with AI from day one — not bolted on later.
        </p>
      </div>
      <div class="founding__body">
        <ul class="tier__list founding__list">
          <li>Website built for how you’ll actually operate</li>
          <li>Email handling and routing</li>
          <li>Payments setup</li>
          <li>Customer support agents from the start</li>
        </ul>
        <p class="tier__note">
          Scoped to your industry and stack. Contact us for a quote.
        </p>
        <a class="btn founding__cta" href={X_DM_URL} target="_blank" rel="noopener noreferrer">
          Contact us for a quote
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </article>

    <div class="pricing-foot">
      <p>
        Pilot can credit toward Build if you expand within 90 days. Run is optional but keeps production
        agents from drifting.
      </p>
      <a class="btn" href={X_DM_URL} target="_blank" rel="noopener noreferrer">
        Get a scoped quote on X
        <span class="btn__arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .tiers {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-8);
  }

  @media (min-width: 900px) {
    .tiers {
      grid-template-columns: repeat(3, 1fr);
      gap: 0;
      border-top: 1px solid var(--ghost);
      border-bottom: 1px solid var(--ghost);
    }
  }

  .tier {
    padding: var(--space-6) 0;
    border-top: 1px solid var(--ghost);
  }

  .tier:last-child {
    border-bottom: 1px solid var(--ghost);
  }

  @media (min-width: 900px) {
    .tier {
      padding: var(--space-7) var(--space-6);
      border-top: 0;
      border-bottom: 0;
      border-right: 1px solid var(--ghost);
    }

    .tier:first-child {
      padding-left: 0;
    }

    .tier:last-child {
      border-right: 0;
      padding-right: 0;
      border-bottom: 0;
    }
  }

  .tier__head {
    margin-bottom: var(--space-5);
  }

  .tier__name {
    margin: 0 0 var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--signal);
  }

  .tier__price {
    margin: 0 0 var(--space-3);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.65rem;
  }

  .tier__amount {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .tier__cadence {
    font-size: var(--text-sm);
    color: var(--slate);
  }

  .tier__blurb {
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    color: var(--slate);
    max-width: 28ch;
  }

  .tier__list {
    list-style: none;
    margin: 0 0 var(--space-5);
    padding: 0;
  }

  .tier__list li {
    position: relative;
    padding: 0.45rem 0 0.45rem 1rem;
    font-size: var(--text-sm);
    color: var(--ink);
    line-height: var(--leading-snug);
  }

  .tier__list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.9em;
    width: 0.3rem;
    height: 0.3rem;
    border-radius: 50%;
    background: var(--signal);
    opacity: 0.55;
  }

  .tier__note {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--slate);
    line-height: var(--leading-snug);
  }

  .founding {
    margin-top: var(--space-8);
    padding: var(--space-7) 0;
    border-top: 1px solid var(--ghost);
    border-bottom: 1px solid var(--ghost);
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 720px) {
    .founding {
      grid-template-columns: minmax(12rem, 1fr) minmax(0, 1.4fr);
      gap: var(--space-8);
      align-items: start;
      padding-block: var(--space-8);
    }
  }

  .founding__name {
    margin: 0 0 var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--signal);
  }

  .founding__price {
    margin: 0 0 var(--space-3);
  }

  .founding__blurb {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
    letter-spacing: -0.015em;
    color: var(--ink);
    max-width: 22ch;
  }

  .founding__list {
    margin-bottom: var(--space-4);
  }

  .founding__cta {
    margin-top: var(--space-5);
  }

  .pricing-foot {
    margin-top: var(--space-8);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
    max-width: 36rem;
  }

  .pricing-foot p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--slate);
    line-height: var(--leading-snug);
  }
</style>
