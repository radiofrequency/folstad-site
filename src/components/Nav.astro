---
const base = import.meta.env.BASE_URL;
const links = [
  { href: "#what-we-do", label: "What" },
  { href: "#how-we-do-it", label: "How" },
  { href: "#starter-kits", label: "Kits" },
  { href: "#pricing", label: "Pricing" },
  { href: "#contact", label: "Contact" },
];
---

<header class="nav">
  <div class="nav__inner wrap">
    <a class="nav__brand" href="#hero" aria-label="Folstad AI home">
      <img class="nav__mark" src={`${base}mark.svg`} width="28" height="28" alt="" />
      <span class="nav__word">Folstad<span class="nav__ai"> AI</span></span>
    </a>

    <button
      class="nav__toggle"
      type="button"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Menu"
    >
      <span></span>
      <span></span>
    </button>

    <nav id="site-nav" class="nav__menu" data-nav-menu aria-label="Primary">
      {
        links.map((l) => (
          <a class="nav__link" href={l.href} data-nav-link>
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--nav-h);
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--ghost);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    gap: var(--space-4);
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--ink);
  }

  .nav__brand:hover {
    color: var(--ink);
  }

  .nav__mark {
    width: 1.75rem;
    height: 1.75rem;
    flex-shrink: 0;
  }

  .nav__word {
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .nav__ai {
    font-weight: 400;
    color: var(--slate);
    letter-spacing: 0.14em;
  }

  .nav__menu {
    display: none;
    align-items: center;
    gap: var(--space-1);
  }

  .nav__link {
    padding: 0.4rem 0.7rem;
    font-size: var(--text-sm);
    color: var(--slate);
    text-decoration: none;
    letter-spacing: 0.02em;
    position: relative;
  }

  .nav__link::after {
    content: "";
    position: absolute;
    left: 0.7rem;
    right: 0.7rem;
    bottom: 0.15rem;
    height: 1px;
    background: var(--signal);
    opacity: 0;
    transform: scaleX(0.4);
    transition: opacity var(--duration) var(--ease), transform var(--duration) var(--ease);
  }

  .nav__link:hover,
  .nav__link.is-active {
    color: var(--ink);
  }

  .nav__link.is-active::after,
  .nav__link:hover::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .nav__toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .nav__toggle span {
    display: block;
    width: 1.1rem;
    height: 1px;
    margin-inline: auto;
    background: var(--ink);
    opacity: 0.55;
    transition: opacity var(--duration) var(--ease);
  }

  .nav__toggle:hover span {
    opacity: 1;
  }

  @media (max-width: 767px) {
    .nav__menu {
      position: absolute;
      top: var(--nav-h);
      left: 0;
      right: 0;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: var(--space-3) var(--space-6) var(--space-5);
      background: var(--paper);
      border-bottom: 1px solid var(--ghost);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-4px);
      transition:
        opacity var(--duration) var(--ease),
        transform var(--duration) var(--ease),
        visibility var(--duration);
    }

    .nav__menu.is-open {
      opacity: 1;
      visibility: visible;
      transform: none;
    }

    .nav__link {
      padding: 0.85rem 0;
      border-bottom: 1px solid var(--ghost);
    }

    .nav__link::after {
      display: none;
    }
  }

  @media (min-width: 768px) {
    .nav__toggle {
      display: none;
    }

    .nav__menu {
      display: flex;
    }
  }
</style>
