{
	email {$CADDY_ACME_EMAIL}
	on_demand_tls {
		ask http://tls-ask:9999/check
		interval 2m
		burst 10
	}
}

# Catch-all HTTPS. tls-ask only allows *.buzzftw.com except www,
# so apex/www stay on CloudFront even if someone points them here.
https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy relay:3000
}
